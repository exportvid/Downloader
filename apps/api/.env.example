# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Postgres (extraction cache + monitoring only — never stores media)
DATABASE_URL=postgresql://exportvid:exportvid@localhost:5432/exportvid

# Redis / Valkey (rate limiting, dedupe locks, BullMQ)
REDIS_URL=redis://localhost:6379

# yt-dlp / ffmpeg binaries (override if not on PATH)
YTDLP_PATH=yt-dlp
# Needs `pip install curl_cffi` next to yt-dlp. Fixes TLS-fingerprint blocks (YouTube, Vimeo). Leave empty to disable.
YTDLP_IMPERSONATE=chrome
# Optional proxy for platforms that block datacenter IPs (TikTok, Instagram, Tumblr, Vimeo, Reddit).
YTDLP_PROXY=
FFMPEG_PATH=ffmpeg

# Cloudflare R2 (S3-compatible) — used only when a merge/re-encode job needs
# temporary storage before the client downloads it. Leave blank in dev; the
# worker will fall back to a local tmp dir and log a warning.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=exportvid-tmp
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# How long a merged temp file survives in R2 before it's deleted, in seconds.
TEMP_FILE_TTL_SECONDS=900

# How long extraction metadata may be cached, in seconds.
EXTRACTION_CACHE_TTL_SECONDS=300

# Hard limits (defense in depth alongside platform-side limits)
MAX_SOURCE_DURATION_SECONDS=7200
MAX_DOWNLOAD_BYTES=2147483648
EXTRACTION_TIMEOUT_MS=25000

# Cloudflare Turnstile secret. When set, /api/v1/extract rejects requests without a valid widget token.
# Leave empty in dev, or use the test secret 1x0000000000000000000000000000000AA (always passes, dev only).
TURNSTILE_SECRET_KEY=
