# Copy to infra/.env.production on the server and fill in every value. Never commit the real file.

# Domain that points at this server (an A record, "DNS only" if you use Cloudflare)
API_DOMAIN=api.exportvid.com
# The website's address. The API only accepts browser requests from here.
WEB_ORIGIN=https://exportvid.com

# A long random password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Cloudflare R2: temporary storage for files that must be merged before download
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=exportvid-tmp

# Cloudflare Turnstile secret key (the site key goes in Vercel). Without it, bots can use the API freely.
TURNSTILE_SECRET_KEY=

# Residential proxy for TikTok, Instagram, Tumblr, and Vimeo, for example http://user:pass@host:port
YTDLP_PROXY=
YTDLP_IMPERSONATE=chrome

# Retention. These numbers appear in the Privacy Policy, so change them there too.
TEMP_FILE_TTL_SECONDS=900
EXTRACTION_CACHE_TTL_SECONDS=300

MAX_SOURCE_DURATION_SECONDS=7200
MAX_DOWNLOAD_BYTES=2147483648
EXTRACTION_TIMEOUT_MS=25000
